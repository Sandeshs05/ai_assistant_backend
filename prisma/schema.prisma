// School CRM — Month 1 foundational schema
// Relational design: User ↔ Role (RBAC), User ↔ School (multi-tenant), profile tables per persona

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirrors application Role enum — stored in DB for flexibility (custom roles later)
enum RoleName {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Core auth identity — every login maps to one User row
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  // null for SUPER_ADMIN (platform-wide); set for school-scoped roles
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  teacher   Teacher?
  student   Student?
  parent    Parent?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([roleId])
}

model School {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  users     User[]
  teachers  Teacher[]
  students  Student[]
  parents   Parent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Teacher {
  id         String   @id @default(uuid())
  employeeId String
  department String?
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model Student {
  id          String    @id @default(uuid())
  admissionNo String
  grade       String?
  dateOfBirth DateTime?
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  parentId    String?
  parent      Parent?   @relation(fields: [parentId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([parentId])
}

model Parent {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}
